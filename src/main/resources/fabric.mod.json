{
  "schemaVersion": 1,
  "id": "donutgamble",
  "version": "${version}",
  "name": "DonutPayback",
  "description": "Tracks DonutSMP /pay payments, pending confirmations, and repayment reminders.",
  "authors": [
    "DonutPayback"
  ],
  "contact": {
    "sources": "https://github.com/"
  },
  "license": "CC0-1.0",
  "icon": "assets/donutgamble/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "donutgamble.Donutgamble"
    ],
    "client": [
      "donutgamble.client.DonutgambleClient"
    ]
  },
  "mixins": [
    "donutgamble.mixins.json",
    {
      "config": "donutgamble.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
